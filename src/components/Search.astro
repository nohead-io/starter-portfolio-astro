---
// Search: a button in the header that opens a modal search box (also on
// ⌘K / Ctrl+K and "/"), listing posts as links with their date, a snippet
// and the matched words marked. Each search goes to Nohead's public search
// with the site's search token, through the SDK's searchPublic, and a hit
// carries all a result shows: the posts' search settings include their
// cover's URL and their authors' names (`expanded`), and leave out the body,
// which searches still match (`included: false`). Searches match authors'
// names too (`searched`), marked in the byline. The latest posts, shown
// before anything is typed, are written into the page when the site is
// built, so the box opens with them at once and searches only once someone
// types. The layout renders it only when the site has a search token
// (content.ts), so without one no page loads its script.
import { Image } from "astro:assets"
import { authorsOf, formatDate, photoOf, posts } from "../lib/content"

interface Props {
  token: string
  index: string
}

const { token, index } = Astro.props
/** As fresh as the page: the site is rebuilt when a post is published. */
const latest = await Promise.all(
  posts.slice(0, 5).map(async (post) => ({
    post,
    cover: photoOf(post.data.cover),
    byline: (await authorsOf(post)).map((author) => author.data.name).join(" and "),
  }))
)
---

<button type="button" class="search-open" aria-haspopup="dialog" aria-controls="search-dialog">
  <svg viewBox="0 0 20 20" aria-hidden="true">
    <circle cx="8.5" cy="8.5" r="5.5"></circle>
    <path d="m13 13 4 4"></path>
  </svg>
  <span class="visually-hidden">Search</span>
</button>

<dialog
  id="search-dialog"
  class="search-dialog"
  aria-label="Search the journal"
  data-search-token={token}
  data-search-index={index}
>
  <div class="field">
    <svg viewBox="0 0 20 20" aria-hidden="true">
      <circle cx="8.5" cy="8.5" r="5.5"></circle>
      <path d="m13 13 4 4"></path>
    </svg>
    <input
      type="text"
      role="combobox"
      aria-expanded="true"
      aria-controls="search-results"
      aria-autocomplete="list"
      placeholder="Search the journal"
      aria-label="Search the journal"
      autocomplete="off"
      spellcheck="false"
      enterkeyhint="search"
    />
    <button type="button" class="close" aria-label="Esc, close search">
      esc
    </button>
  </div>
  <div class="body">
    <p class="heading" id="search-heading">
      Latest
    </p>
    <div id="search-results" class="results" role="listbox" aria-labelledby="search-heading"></div>
    <p class="empty" hidden></p>
  </div>
  <p class="visually-hidden" aria-live="polite" data-status></p>
  <template id="search-latest">
    {latest.map(({ post, cover, byline }, i) => (
      <a href={`/posts/${post.data.slug}`} id={`search-option-${i}`} role="option" tabindex="-1">
        {cover ? (
          <Image src={cover.src} alt="" width={72} height={54} densities={[1, 2]} fit="cover" class="thumb" />
        ) : (
          <span class="thumb" />
        )}
        <span class="text">
          <span class="meta">{[formatDate(post.data.date), byline].filter(Boolean).join(" · ")}</span>
          <span class="title">{post.data.title}</span>
          <span class="summary">{post.data.summary}</span>
        </span>
        <kbd class="enter" aria-hidden="true">
          ↵
        </kbd>
      </a>
    ))}
  </template>
</dialog>

<script>
  import { imageUrl } from "@nohead/sdk/images"
  import {
    SEARCH_URL,
    searchPublic,
    snippet,
    type ExpandedAsset,
    type ExpandedRecord,
    type SearchHit,
    type Segment,
  } from "@nohead/sdk/search"

  /** A post as search returns it: dates as Unix seconds, relations as IDs. */
  interface Post {
    title: string
    slug: string
    summary: string
    date: number
  }
  /** What the posts' search settings include of their cover and authors. */
  interface Expanded {
    cover: ExpandedAsset
    authors: ExpandedRecord<{ name: string }>[]
  }
  type Hit = SearchHit<Post, Expanded>

  setUp(document.querySelector<HTMLDialogElement>("#search-dialog")!)

  function setUp(dialog: HTMLDialogElement) {
    const opener = document.querySelector<HTMLButtonElement>(".search-open")!
    const input = dialog.querySelector<HTMLInputElement>("input")!
    const list = dialog.querySelector<HTMLElement>(".results")!
    const heading = dialog.querySelector<HTMLElement>(".heading")!
    const empty = dialog.querySelector<HTMLElement>(".empty")!
    const status = dialog.querySelector<HTMLElement>("[data-status]")!
    const token = dialog.dataset.searchToken!
    const index = dialog.dataset.searchIndex!
    const latest = dialog.querySelector<HTMLTemplateElement>("#search-latest")!

    /** Shorter queries show the latest posts instead. */
    const MIN_QUERY = 2
    /** Wait for a pause in typing: each search is a request. */
    const DEBOUNCE_MS = 150

    let active = 0
    let timer: number | undefined
    let failed = false
    let controller: AbortController | undefined
    /** The search under way, which keys wait for. */
    let pending: Promise<void> | undefined

    /** The best matches, marked. */
    function search(q: string, signal: AbortSignal) {
      return searchPublic<Post, Expanded>({
        token,
        index,
        q,
        limit: 20,
        highlight: ["title", "summary", "authors.name"],
        signal,
      })
    }

    /** The latest posts, from the page: what an empty box shows, at once. */
    function showLatest() {
      list.replaceChildren(latest.content.cloneNode(true))
      list.querySelectorAll<HTMLElement>("[role=option]").forEach((el, i) => {
        el.addEventListener("mousemove", (event) => hover(event, i))
      })
      failed = false
      heading.textContent = "Latest"
      heading.hidden = list.children.length === 0
      empty.hidden = true
      status.textContent = ""
      select(0)
    }

    /** Highlighted text as text and <mark> elements, built as nodes. */
    const marked = (segments: Segment[]): Node[] =>
      segments.map(({ text, match }) =>
        match
          ? Object.assign(document.createElement("mark"), { textContent: text })
          : document.createTextNode(text)
      )

    const formatDate = (seconds: number) =>
      new Date(seconds * 1000).toLocaleDateString("en-IE", {
        day: "numeric",
        month: "long",
        year: "numeric",
        timeZone: "UTC",
      })

    function option(hit: Hit, i: number): HTMLAnchorElement {
      const link = document.createElement("a")
      link.href = `/posts/${hit.data.slug}`
      link.id = `search-option-${i}`
      link.setAttribute("role", "option")
      link.tabIndex = -1

      // The cover, cropped to the thumbnail's shape, at 1x and 2x.
      const cover = hit.expanded.cover?.image_url
      let thumb: HTMLElement
      if (cover) {
        const crop = (scale: number) =>
          imageUrl(cover, {
            width: 72 * scale,
            height: 54 * scale,
            fit: "cover",
            quality: 70,
            format: "webp",
          })
        thumb = Object.assign(document.createElement("img"), {
          src: crop(1),
          srcset: `${crop(2)} 2x`,
          alt: "",
          width: 72,
          height: 54,
          decoding: "async",
        })
      } else thumb = document.createElement("span")
      thumb.className = "thumb"

      const text = document.createElement("span")
      text.className = "text"
      const meta = document.createElement("span")
      meta.className = "meta"
      // The date, then the authors, a name marked where the search matched it.
      meta.append(formatDate(hit.data.date))
      for (const [i, author] of (hit.expanded.authors ?? []).entries()) {
        meta.append(i === 0 ? " · " : " and ")
        meta.append(...marked(author.highlights?.name ?? [{ text: author.data.name ?? "", match: false }]))
      }
      const title = document.createElement("span")
      title.className = "title"
      title.append(...marked(hit.highlights.title ?? [{ text: hit.data.title, match: false }]))
      const summary = document.createElement("span")
      summary.className = "summary"
      // A match's summary from a little before the match, so the match shows.
      const matched = hit.highlights.summary
      summary.append(...(matched ? marked(snippet(matched)) : [hit.data.summary]))
      text.append(meta, title, summary)

      const enter = document.createElement("kbd")
      enter.className = "enter"
      enter.setAttribute("aria-hidden", "true")
      enter.textContent = "↵"

      link.append(thumb, text, enter)
      link.addEventListener("mousemove", (event) => hover(event, i))
      return link
    }

    // The pointer picks a result only when it moves: the list scrolling under
    // a resting pointer (as the arrow keys scroll it) fires mousemove too, and
    // would take the selection back from the keys.
    let pointer = ""
    function hover(event: MouseEvent, i: number) {
      const at = `${event.screenX},${event.screenY}`
      if (at === pointer || (event.movementX === 0 && event.movementY === 0)) return
      pointer = at
      select(i, false)
    }

    function select(i: number, scroll = true) {
      const options = [...list.querySelectorAll<HTMLElement>("[role=option]")]
      if (options.length === 0) {
        input.removeAttribute("aria-activedescendant")
        return
      }
      active = (i + options.length) % options.length
      options.forEach((el, n) => el.setAttribute("aria-selected", String(n === active)))
      input.setAttribute("aria-activedescendant", options[active]!.id)
      if (scroll) options[active]!.scrollIntoView({ block: "nearest" })
    }

    /** Searches for what is typed now and shows it; a newer search cancels this one. */
    function render() {
      pending = show()
      return pending
    }

    async function show() {
      clearTimeout(timer)
      timer = undefined
      const typed = input.value.trim()
      const query = typed.length >= MIN_QUERY ? typed : ""
      controller?.abort()
      if (!query) return showLatest()
      controller = new AbortController()
      const { signal } = controller
      let hits: Hit[] = []
      let total = 0
      try {
        ;({ hits, total } = await search(query, signal))
        failed = false
      } catch {
        if (signal.aborted) return
        failed = true
      }
      list.replaceChildren(...hits.map(option))
      const count = `${total} ${total === 1 ? "post" : "posts"}`
      heading.textContent = count
      heading.hidden = hits.length === 0
      empty.hidden = hits.length > 0
      if (failed) empty.replaceChildren("Search didn't load. Check your connection and try again.")
      else
        empty.replaceChildren(
          "Nothing matches “",
          Object.assign(document.createElement("strong"), { textContent: query }),
          "”. Try a building or a place."
        )
      status.textContent = failed
        ? "Search didn't load."
        : hits.length === 0
          ? `No posts match ${query}.`
          : `${count} found.`
      select(0)
    }

    // While the panel is open the page stays put: pinned where it was
    // scrolled to, which iPhones respect even with the keyboard up (the
    // stylesheet's overflow: hidden alone isn't enough there), and put back
    // when it closes.
    let pinnedAt = 0
    function pin() {
      pinnedAt = window.scrollY
      Object.assign(document.body.style, { position: "fixed", top: `-${pinnedAt}px`, left: "0", right: "0" })
    }
    function unpin() {
      for (const property of ["position", "top", "left", "right"])
        document.body.style.removeProperty(property)
      window.scrollTo({ top: pinnedAt, behavior: "instant" })
    }
    dialog.addEventListener("close", unpin)

    function open() {
      if (dialog.open) return
      input.value = ""
      warm()
      pin()
      if (window.visualViewport) fit()
      dialog.showModal()
      input.focus()
      render()
    }

    /**
     * Opens the connection to the search host as the box opens, while the
     * latest posts show and before the first word is typed, so the first
     * search doesn't wait for it. Not in the page's head: an unused
     * connection closes after about ten seconds. `crossorigin`, as the
     * search's fetch carries no cookies, or the browser won't reuse it.
     */
    let warmed = false
    function warm() {
      if (warmed) return
      warmed = true
      document.head.append(
        Object.assign(document.createElement("link"), {
          rel: "preconnect",
          href: SEARCH_URL,
          crossOrigin: "",
        })
      )
    }

    opener.addEventListener("click", open)
    dialog.querySelector(".close")!.addEventListener("click", () => dialog.close())
    input.addEventListener("input", () => {
      clearTimeout(timer)
      timer = window.setTimeout(render, DEBOUNCE_MS)
    })

    input.addEventListener("keydown", async (event) => {
      // Enter also confirms a word in an input method editor: leave it be.
      if (event.isComposing || !["ArrowDown", "ArrowUp", "Enter"].includes(event.key)) return
      event.preventDefault()
      // On a touch screen the keyboard's Search key only puts the keyboard
      // away, so the results show in full; a tap opens one.
      if (event.key === "Enter" && matchMedia("(hover: none) and (pointer: coarse)").matches) {
        input.blur()
        return
      }
      // Keys act on the results for what is typed now: before the pause ends
      // and while its search is still on its way.
      if (timer !== undefined) await render()
      else await pending
      if (event.key === "Enter") {
        const chosen = list.querySelector<HTMLAnchorElement>(`#search-option-${active}`)
        if (!chosen) return
        if (event.metaKey || event.ctrlKey) window.open(chosen.href, "_blank")
        else chosen.click()
      } else {
        select(active + (event.key === "ArrowDown" ? 1 : -1))
      }
    })

    // The panel fits the part of the screen the on-screen keyboard leaves
    // (the visual viewport), so every result can be scrolled to with the
    // keyboard up.
    const fit = () => dialog.style.setProperty("--visible-height", `${window.visualViewport!.height}px`)
    window.visualViewport?.addEventListener("resize", () => {
      if (dialog.open) fit()
    })

    // While the on-screen keyboard is up, iOS pans the screen for a drag
    // instead of scrolling the results, so a finger on the results puts the
    // keyboard away first. The panel stays where it is, so a tap still opens
    // the result under it.
    const scroller = dialog.querySelector<HTMLElement>(".body")!
    let lastY = 0
    document.addEventListener(
      "touchstart",
      (event) => {
        lastY = event.touches[0]?.clientY ?? 0
        if (dialog.open && event.target instanceof Node && scroller.contains(event.target)) input.blur()
      },
      { passive: true }
    )
    // A drag only goes ahead where it scrolls the results; anywhere else in
    // the open panel or on the page behind, it's held.
    document.addEventListener(
      "touchmove",
      (event) => {
        if (!dialog.open) return
        const y = event.touches[0]?.clientY ?? lastY
        const up = y > lastY
        lastY = y
        const scrolls =
          event.target instanceof Node &&
          scroller.contains(event.target) &&
          (up
            ? scroller.scrollTop > 0
            : scroller.scrollTop + scroller.clientHeight < scroller.scrollHeight - 1)
        if (!scrolls) event.preventDefault()
      },
      { passive: false }
    )

    // A click on the backdrop (outside the panel) closes it.
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close()
    })

    document.addEventListener("keydown", (event) => {
      const target = event.target
      const typing = target instanceof Element && target.closest("input, textarea, [contenteditable]")
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
        event.preventDefault()
        if (dialog.open) dialog.close()
        else open()
      } else if (event.key === "/" && !typing && !dialog.open) {
        event.preventDefault()
        open()
      }
    })
  }
</script>

<style>
  .search-open {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin: -8px -8px -8px 0;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--muted);
    cursor: pointer;
    transition:
      color 0.15s ease-out,
      background-color 0.15s ease-out;
  }
  .search-open:hover {
    color: var(--ink);
    background: var(--band);
  }
  .search-open:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  svg {
    width: 18px;
    height: 18px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  /* The panel */
  .search-dialog {
    width: min(620px, calc(100% - 32px));
    max-height: min(600px, calc(var(--visible-height, 100dvh) - 120px));
    margin: 12vh auto auto;
    padding: 0;
    border: 0;
    border-radius: 12px;
    background: var(--card);
    color: var(--ink);
    box-shadow:
      0 0 0 1px var(--panel-edge),
      0 40px 80px -20px rgb(0 0 0 / 0.35),
      0 16px 32px -16px rgb(0 0 0 / 0.25);
    overflow: hidden;
    flex-direction: column;
  }
  .search-dialog[open] {
    display: flex;
    animation: rise 0.2s cubic-bezier(0.2, 0.9, 0.3, 1);
  }
  .search-dialog::backdrop {
    background: rgb(0 0 0 / 0.3);
    backdrop-filter: blur(6px) saturate(0.9);
    animation: fade 0.2s ease-out;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.985);
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .search-dialog[open],
    .search-dialog::backdrop {
      animation: none;
    }
  }

  /* The box */
  .field {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 0 20px;
    border-bottom: 1px solid var(--guide);
    color: var(--faint);
  }
  .field svg {
    width: 20px;
    height: 20px;
  }
  .field input {
    flex: 1;
    min-width: 0;
    padding: 22px 0;
    border: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    font-size: 1.25rem;
    line-height: 1.2;
    caret-color: var(--accent);
  }
  .field input:focus {
    outline: none;
  }
  .field input::placeholder {
    color: var(--muted);
  }
  .close {
    padding: 3px 8px;
    border: 1px solid var(--guide);
    border-radius: 6px;
    background: none;
    color: var(--muted);
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
  }
  .close:hover {
    color: var(--ink);
  }

  /* While the panel is open the page stays put, so a drag scrolls the
     results, not the page behind (iOS hands it to the page while the
     keyboard is up). The scrollbar's room stays, so nothing shifts. */
  :global(html:has(.search-dialog[open])) {
    overflow: hidden;
    scrollbar-gutter: stable;
  }

  /* Results: the part of the panel that shrinks and scrolls. */
  .body {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 6px 8px 8px;
  }
  .heading {
    margin: 0;
    padding: 10px 12px 6px;
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 600;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.08em;
  }
  .results :global([role="option"]) {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 16px;
    align-items: center;
    padding: 10px 12px;
    border-radius: 8px;
    text-decoration: none;
    scroll-margin: 8px;
  }
  .results :global([aria-selected="true"]) {
    background: var(--selected);
  }
  /* The cover, or its place where a post has none, so titles line up. */
  .results :global(.thumb) {
    display: block;
    width: 72px;
    height: 54px;
    border-radius: 4px;
    object-fit: cover;
    background: var(--guide);
  }
  .results :global(.text) {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .results :global(.meta) {
    color: var(--muted);
    font-size: 0.85rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .results :global(.title) {
    font-family: var(--display);
    font-size: 1.08rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink);
  }
  .results :global(.summary) {
    color: var(--muted);
    font-size: 0.92rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* A matched word: a soft ink marker, and full ink in the muted summary.
     The padding reaches past the word without moving it. */
  .results :global(mark) {
    padding: 0.04em 0.12em;
    margin: 0 -0.12em;
    border-radius: 0.25em;
    background: color-mix(in oklab, var(--ink) 11%, transparent);
    color: var(--ink);
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  .results :global(.enter) {
    visibility: hidden;
    padding: 2px 7px;
    border: 1px solid var(--guide);
    border-radius: 6px;
    background: var(--card);
    color: var(--muted);
    font: inherit;
    font-size: 0.85rem;
  }
  .results :global([aria-selected="true"] .enter) {
    visibility: visible;
  }
  .empty {
    margin: 0;
    padding: 36px 12px 40px;
    color: var(--muted);
    text-align: center;
  }
  .empty :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }

  @media (max-width: 860px) {
    .search-dialog {
      margin-top: 16px;
      max-height: min(600px, calc(var(--visible-height, 100dvh) - 32px));
    }
    .results :global([role="option"]) {
      grid-template-columns: auto 1fr;
      gap: 12px;
    }
    .results :global(.enter) {
      display: none;
    }
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
