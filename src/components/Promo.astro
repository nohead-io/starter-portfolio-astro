---
// The band before the footer: Long Section is fiction, this is a Nohead
// starter, and where to go next. Its tint runs the full width of the window,
// under the guides.
const repository = "https://github.com/nohead-io/starter-portfolio-astro"
const nohead = "https://nohead.io"
---

<section class="grid promo" aria-labelledby="promo-title">
  <div class="lead">
    <h2 id="promo-title" class="display">
      Long Section is made up.
    </h2>
    <p>
      The studio, its people, its clients and their buildings are invented, to show what a site built on
      Nohead looks like. The projects, posts, people and images live in a Nohead project; Astro builds the
      site.
    </p>
    <a class="button" href={repository}>
      Use this starter
      <svg viewBox="0 0 10 10" aria-hidden="true">
        <path d="M3 1.5 6.5 5 3 8.5" />
      </svg>
    </a>
  </div>
  <div class="card">
    <h3 class="tick tick-inset">Make it yours</h3>
    <p>
      Clone the starter, connect it to your own project, and replace Long Section with your own story.
      Publishing a post rebuilds the site.
    </p>
    <a class="more" href={repository}>
      View on GitHub
      <svg viewBox="0 0 10 10" aria-hidden="true">
        <path d="M3 1.5 6.5 5 3 8.5" />
      </svg>
    </a>
  </div>
  <div class="card">
    <h3 class="tick tick-inset">What is Nohead?</h3>
    <p>
      Design your content model, edit and publish in a shared editor, and read it anywhere through the API and
      SDKs.
    </p>
    <a class="more" href={nohead}>
      Visit nohead.io
      <svg viewBox="0 0 10 10" aria-hidden="true">
        <path d="M3 1.5 6.5 5 3 8.5" />
      </svg>
    </a>
  </div>
</section>

<style>
  .promo {
    position: relative;
    margin-top: 140px;
    padding: 112px 0;
    align-items: start;
  }
  /* The tint, from window edge to window edge (the frame is centred),
     painted below the guides (z-index -1). */
  .promo::before {
    content: "";
    position: absolute;
    inset: 0 calc(50% - 50vw);
    z-index: -2;
    background: var(--band);
  }
  .lead {
    grid-column: 1 / 3;
  }
  h2 {
    margin: 0;
    font-size: clamp(1.6rem, 2.5vw, 2rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.015em;
  }
  .lead p {
    margin: 20px 0 28px;
    max-width: 30em;
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--muted);
    text-wrap: pretty;
  }
  .button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px 10px 20px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.15s ease-out;
  }
  .button:hover {
    background: var(--accent-strong);
  }
  .card {
    padding-top: 4px;
  }
  h3 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--ink);
  }
  .card p {
    margin: 10px 0 14px;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--muted);
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
  }
  a svg {
    width: 0.7em;
    height: 0.7em;
    margin-top: 0.1em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.15s ease-out;
  }
  /* Moves only on a real hover, and not under reduced motion. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    a:hover svg {
      transform: translateX(3px);
    }
  }
  @media (max-width: 860px) {
    .promo {
      margin-top: 96px;
      padding: 72px 0;
      row-gap: 48px;
    }
  }
  /* The two cards side by side on a tablet, one on each half. */
  @media (min-width: 501px) and (max-width: 860px) {
    .promo {
      grid-template-columns: 1fr 1fr;
    }
    .promo > .card {
      grid-column: auto !important;
    }
  }
</style>
