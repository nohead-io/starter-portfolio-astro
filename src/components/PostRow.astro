---
// One post in a list, laid out on the four-column grid: category and title
// across three columns, date and author in the fourth, the summary beside a
// cover that spans the right half. A post with two authors gives the title
// the left half and the bylines a column each, side by side.
import { getEntry } from "astro:content"
import { authorsOf, categoryHref, formatDate, type Post } from "../lib/content"
import Byline from "./Byline.astro"
import Cover from "./Cover.astro"

interface Props {
  post: Post
}

const { post } = Astro.props
const { title, date, summary, slug } = post.data
// An unpublished category isn't in its collection, so it's left out.
const category = await getEntry(post.data.category)
const authors = await authorsOf(post)
const href = `/posts/${slug}`
const duo = authors.length > 1
---

<article class:list={["grid", "row", { duo }]}>
  <p class="tick cat">
    {category && (
      <a class="category" href={categoryHref(category)}>
        {category.data.name}
      </a>
    )}
  </p>
  <p class="tick date">
    <time datetime={date.toISOString()}>{formatDate(date)}</time>
  </p>
  <h2 class="title display">
    <a href={href}>{title}</a>
  </h2>
  <div class="author">
    {authors.map((author) => (
      <Byline author={author} />
    ))}
  </div>
  <div class="summary">
    <p>{summary}</p>
    <a class="more" href={href} aria-hidden="true" tabindex="-1">
      Read more<span class="more-title">: {title}</span>{" "}
      <svg viewBox="0 0 10 10" width="10" height="10" aria-hidden="true">
        <path
          d="M3 1.5 6.5 5 3 8.5"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </a>
  </div>
  <a class="cover-link" href={href} aria-hidden="true" tabindex="-1">
    <Cover post={post} decorative />
  </a>
</article>

<style>
  /* The post's title in the "Read more" link's text, not shown, since the
     title is just above it. */
  .more-title {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .row {
    padding: 88px 0 24px;
    row-gap: 8px;
  }
  /* Category and date share the first row, on one baseline. */
  .cat {
    grid-column: 1 / 4;
    margin: 0;
    align-self: baseline;
  }
  .date {
    grid-column: 4;
    grid-row: 1;
    margin: 0;
    align-self: baseline;
  }
  .title {
    grid-column: 1 / 4;
    margin: 4px 0 0;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .title a {
    text-decoration: none;
  }
  .title a:hover {
    color: var(--accent);
  }
  .author {
    grid-column: 4;
    grid-row: 2;
    padding-top: 10px;
  }
  .summary {
    grid-column: 1 / 3;
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--muted);
  }
  .summary p {
    margin: 16px 0 14px;
    max-width: 30em;
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--accent);
    font-size: 1.1rem;
    font-weight: 600;
    text-decoration: none;
  }
  .more svg {
    width: 0.55em;
    height: 0.55em;
    margin-top: 0.1em;
    transition: transform 0.15s ease-out;
  }
  /* Moves only on a real hover, and not under reduced motion. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .more:hover svg {
      transform: translateX(3px);
    }
  }
  /* The cover runs from guide to guide: no column padding. */
  .cover-link {
    text-decoration: none;
    grid-column: 3 / 5;
    padding: 24px 0 0;
  }
  @media (min-width: 861px) {
    .duo .cat,
    .duo .title {
      grid-column: 1 / 3;
    }
    .duo .date {
      grid-column: 3 / 5;
    }
    /* Two bylines, each starting at its own column's text edge. */
    .duo .author {
      grid-column: 3 / 5;
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: calc(2 * var(--gutter));
    }
  }
  @media (max-width: 860px) {
    .author {
      display: grid;
      gap: 16px;
    }
  }
  /* Two bylines side by side on a tablet, one on each half, as on desktop. */
  @media (min-width: 501px) and (max-width: 860px) {
    .duo .author {
      grid-template-columns: 1fr 1fr;
      column-gap: calc(2 * var(--gutter));
    }
  }
  @media (max-width: 860px) {
    /* Two halves, so the date hangs on the middle guide beside the
       category. */
    .row {
      padding-top: 56px;
      grid-template-columns: 1fr 1fr;
    }
    .row > .cat {
      grid-column: 1 !important;
      grid-row: 2;
    }
    .row > .date {
      grid-column: 2 !important;
      grid-row: 2;
    }
    .author {
      grid-row: auto;
    }
    /* The cover leads on phones, above the category and date. */
    .cover-link {
      grid-row: 1;
      padding: 0 0 24px;
    }
  }
</style>
