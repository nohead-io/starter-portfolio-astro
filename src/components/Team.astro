---
// The team: everyone's portrait, name, role and studio, each linking to their
// page. At the end of the About page.
import { Image } from "astro:assets"
import { people, photoOf } from "../lib/content"
---

<section class="team" aria-labelledby="team-title">
  <header class="grid intro">
    <h2 class="display" id="team-title">
      Team
    </h2>
  </header>
  <ul class="grid people">
    {people.map(({ data }) => {
      const portrait = photoOf(data.portrait)
      return (
        <li>
          <a href={`/team/${data.slug}`}>
            {portrait && (
              <Image src={portrait.src} alt="" width={250} height={250} densities={[1, 2]} fit="cover" />
            )}
            <span class="name">{data.name}</span>
            <span class="role">
              {data.role} · {data.studio}
            </span>
          </a>
        </li>
      )
    })}
  </ul>
</section>

<style>
  .team {
    padding-top: 120px;
  }
  .intro {
    padding: 0 0 40px;
  }
  h2 {
    grid-column: 1 / 3;
    margin: 0;
    font-size: clamp(2.75rem, 7vw, 5rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.03em;
  }
  .people {
    list-style: none;
    margin: 0;
    padding: 0;
    row-gap: 56px;
  }
  .people a {
    display: block;
    text-decoration: none;
  }
  .people img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 10px;
    margin-bottom: 18px;
  }
  .name {
    display: block;
    font-weight: 600;
    font-size: 1.1rem;
  }
  .role {
    display: block;
    color: var(--muted);
    margin-top: 2px;
  }
  @media (max-width: 860px) {
    .people {
      grid-template-columns: 1fr 1fr;
    }
    .people > * {
      grid-column: auto !important;
    }
  }
</style>
