---
// A few posts in a row of four columns: cover, date, title. Used for "the
// latest from the journal" and for "More from the journal" under a post.
import { Image } from "astro:assets"
import { formatDate, photoOf, WIDTHS, type Post } from "../lib/content"

interface Props {
  posts: Post[]
  heading: string
  /** A link after the heading, like "All posts". */
  more?: { href: string; label: string }
}

const { posts, heading, more } = Astro.props
---

<section class="strip" aria-labelledby={`strip-${heading.replace(/\W+/g, "-").toLowerCase()}`}>
  <header class="grid head">
    <h2 class="display" id={`strip-${heading.replace(/\W+/g, "-").toLowerCase()}`}>
      {heading}
    </h2>
    {more && (
      <a class="more" href={more.href}>
        {more.label}
        <svg viewBox="0 0 10 10" aria-hidden="true">
          <path d="M3 1.5 6.5 5 3 8.5" />
        </svg>
      </a>
    )}
  </header>
  <ul class="grid items">
    {posts.map(({ data }) => {
      const cover = photoOf(data.cover)
      return (
        <li>
          <a href={`/posts/${data.slug}`}>
            {cover && (
              <Image
                src={cover.src}
                width={cover.width}
                height={cover.height}
                alt=""
                widths={WIDTHS}
                sizes="(max-width: 500px) calc(100vw - 64px), (max-width: 860px) calc((100vw - 32px) / 2 - 32px), calc((min(100vw, 1160px) - 32px) / 4 - 32px)"
                class="thumb"
              />
            )}
            <span class="tick tick-inset date">
              <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
            </span>
            <span class="title display">{data.title}</span>
          </a>
        </li>
      )
    })}
  </ul>
</section>

<style>
  .strip {
    padding-top: 120px;
  }
  .head {
    align-items: last baseline;
    padding-bottom: 32px;
  }
  h2 {
    grid-column: 1 / 3;
    margin: 0;
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .more {
    grid-column: 3 / 5;
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
  }
  .more svg,
  .more :global(svg) {
    width: 0.7em;
    height: 0.7em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.15s ease-out;
  }
  /* Moves only on a real hover, and not under reduced motion. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .more:hover svg {
      transform: translateX(3px);
    }
  }
  .items {
    margin: 0;
    padding: 0;
    list-style: none;
    row-gap: 40px;
  }
  .items a {
    display: grid;
    gap: 10px;
    text-decoration: none;
  }
  .items :global(.thumb) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 8px;
    margin-bottom: 8px;
  }
  .date {
    font-size: 0.9rem;
  }
  .title {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.25;
    text-wrap: balance;
  }
  .items a:hover .title {
    color: var(--accent);
  }
  @media (max-width: 860px) {
    .more {
      justify-self: start;
      margin-top: 12px;
    }
  }
  /* Two up on a tablet, one on each half of the grid. */
  @media (min-width: 501px) and (max-width: 860px) {
    .items {
      grid-template-columns: 1fr 1fr;
    }
    .items > li {
      grid-column: auto !important;
    }
  }
</style>
