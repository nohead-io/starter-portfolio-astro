---
import "../styles/global.css"
import { leadPhoto, search, type Photo } from "../lib/content"
import { Font, getImage } from "astro:assets"
import Promo from "../components/Promo.astro"
import Search from "../components/Search.astro"

interface Props {
  title?: string
  description?: string
  /** The page's image for link previews: a post's cover, a project's first photo. Pages without one
     show the first project's first photo. */
  image?: Photo
}

const { title, description, image = leadPhoto } = Astro.props
const siteName = "Long Section"
// Built as files (posts/<slug>.html), served without the extension.
const path = Astro.url.pathname.replace(/(index)?\.html$/, "")
const fullTitle = title ? `${title} · ${siteName}` : siteName
const canonical = new URL(path, Astro.site)
const ogImage = image
  ? new URL(
      (await getImage({ src: image.src, width: 1200, height: 630, fit: "cover", format: "jpeg" })).src,
      Astro.site
    )
  : undefined
/** Each item is current on its own pages and the ones below it. */
const nav = [
  { href: "/", label: "Work", current: path === "/" || path.startsWith("/work") },
  {
    href: "/journal",
    label: "Journal",
    current: ["/journal", "/posts", "/categories"].some((p) => path.startsWith(p)),
  },
  {
    href: "/about",
    label: "About",
    current: ["/about", "/team"].some((p) => path.startsWith(p)),
  },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <Font cssVariable="--font-inter-tight" preload={[{ subset: "latin" }]} />
    <Font cssVariable="--font-source-sans" preload={[{ subset: "latin", style: "normal" }]} />
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* Every page shows photos from Nohead's image host: connect while the head is read. */}
    <link rel="preconnect" href="https://images.nohead.io" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title ?? siteName} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={path.startsWith("/posts/") ? "article" : "website"} />
    {ogImage && image && (
      <>
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        {image.alt && <meta property="og:image:alt" content={image.alt} />}
      </>
    )}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <link rel="alternate" type="application/rss+xml" title="Long Section Journal" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <a class="skip" href="#content">
      Skip to content
    </a>
    <div class="frame">
      <div class="guides" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
        <span></span>
      </div>
      <header class="grid site-header">
        <a href="/" class="wordmark display">
          Long Section
        </a>
        <nav aria-label="Main">
          {nav.map(({ href, label, current }) => (
            <a href={href} aria-current={current ? "page" : undefined}>
              {label}
            </a>
          ))}
          {search && <Search {...search} />}
          <a class="icon-link" href="/rss.xml" aria-label="RSS feed">
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M4 4a12 12 0 0 1 12 12" />
              <path d="M4 9a7 7 0 0 1 7 7" />
              <circle cx="5" cy="15" r="1.4" />
            </svg>
          </a>
        </nav>
      </header>
      <main id="content" tabindex="-1">
        <slot />
      </main>
      <Promo />
      <footer class="grid site-footer">
        <p>Long Section, a Nohead portfolio starter.</p>
        <nav aria-label="Footer">
          <a href="/about">About</a>
          <a href="/colophon">Colophon</a>
        </nav>
      </footer>
    </div>
  </body>
</html>

<style>
  /* Hidden until a keyboard user reaches it first. */
  .skip {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 10;
    padding: 8px 14px;
    border-radius: 6px;
    background: var(--ink);
    color: var(--paper);
    text-decoration: none;
    transform: translateY(-200%);
  }
  .skip:focus-visible {
    transform: none;
  }
  /* The skip link's target takes focus but isn't a control. */
  main:focus {
    outline: none;
  }
  .site-header {
    align-items: center;
    padding: 28px 0;
    border-bottom: 1px solid var(--grid);
  }
  .wordmark {
    grid-column: 1 / 3;
    font-family: var(--sans);
    font-size: 1.35rem;
    font-weight: 700;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.08em;
    text-decoration: none;
  }
  .site-header nav {
    grid-column: 3 / 5;
    display: flex;
    gap: 28px;
    align-items: center;
    justify-content: flex-end;
  }
  /* At full width (the frame stops growing), the links start on the last
     column's text edge and the icons sit at the end. */
  @media (min-width: 1192px) {
    .site-header nav {
      grid-column: 4;
      justify-content: flex-start;
      gap: 20px;
    }
    .site-header nav :global(.search-open) {
      flex: none;
      margin-left: auto;
    }
    /* The icons' 36px targets touch, as at the narrower gap below. */
    .site-header nav .icon-link {
      flex: none;
      margin-left: -12px;
    }
  }
  nav a {
    text-decoration: none;
    color: var(--muted);
    font-size: 1rem;
  }
  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--ink);
  }
  /* Icon links sit with the search button, which has a 36px target. */
  .icon-link {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin: -8px -8px -8px -20px;
    border-radius: 999px;
    transition:
      background-color 0.15s ease-out,
      color 0.15s ease-out;
  }
  .icon-link:hover {
    background: var(--band);
  }
  .icon-link svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }
  .icon-link circle {
    fill: currentColor;
    stroke: none;
  }
  .site-footer {
    padding: 32px 0 48px;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .site-footer p {
    grid-column: 1 / 3;
    margin: 0;
  }
  .site-footer nav {
    grid-column: 4;
    display: flex;
    gap: 28px;
    justify-content: flex-end;
  }
  /* The header stays on one row, wordmark and nav, until the nav no longer
     fits beside the wordmark. */
  @media (min-width: 501px) and (max-width: 860px) {
    .site-header {
      display: flex;
      justify-content: space-between;
    }
  }
  @media (max-width: 500px) {
    .site-header nav {
      justify-content: flex-start;
      margin-top: 12px;
    }
  }
  @media (max-width: 860px) {
    .site-footer nav {
      justify-content: flex-start;
      margin-top: 16px;
    }
  }
</style>
