---
// The page for an address that doesn't exist: an old link, a mistyped
// slug. Hosts serve it with a 404 status.
import Base from "../layouts/Base.astro"
---

<Base title="Page not found">
  <section class="grid intro">
    <h1 class="display">Page not found</h1>
    <p>
      Nothing lives at this address. It may have moved: try <a href="/">the work</a>,{" "}
      <a href="/journal">the journal</a> or search.
    </p>
  </section>
</Base>

<style>
  .intro {
    padding: 96px 0 160px;
  }
  h1 {
    grid-column: 1 / 3;
    margin: 0;
    font-size: clamp(2.75rem, 7vw, 5rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.03em;
  }
  p {
    grid-column: 1 / 3;
    margin: 24px 0 0;
    max-width: 30em;
    font-size: 1.2rem;
    line-height: 1.55;
    color: var(--muted);
  }
  p a {
    color: var(--ink);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }
</style>
