---
import Base from "../../layouts/Base.astro"
import Gallery from "../../components/Gallery.astro"
import ProjectCards from "../../components/ProjectCards.astro"
import { render } from "astro:content"
import { photosOf, projects, type Project } from "../../lib/content"

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }))
}

const { project } = Astro.props as { project: Project }
const data = project.data
const gallery = photosOf(data.gallery)
const { Content } = await render(project)
// Up to two more projects to end on: the next ones in order, wrapping
// around, never this one.
const at = projects.findIndex((p) => p.id === project.id)
const more = [...projects.slice(at + 1), ...projects.slice(0, at)].slice(0, 2)
---

<Base title={data.title} description={data.summary} image={gallery[0]}>
  <article>
    <header class="grid head">
      <p class="tick label">
        <a href="/">Work</a>
      </p>
      <h1 class="display">{data.title}</h1>
      <p class="lede text">{data.summary}</p>
    </header>

    <dl class="grid facts">
      <div>
        <dt class="tick tick-inset">Client</dt>
        <dd>{data.client}</dd>
      </div>
      <div>
        <dt class="tick tick-inset">Location</dt>
        <dd>{data.location}</dd>
      </div>
      <div>
        <dt class="tick tick-inset">Year</dt>
        <dd>{data.year}</dd>
      </div>
      <div>
        <dt class="tick tick-inset">Services</dt>
        <dd>{data.services.join(", ")}</dd>
      </div>
    </dl>

    {gallery.length > 0 && (
      <div class="gallery-wrap">
        <Gallery items={gallery} label={`${data.title}, gallery`} />
      </div>
    )}

    <div class="grid body">
      <p class="tick aside">Case study</p>
      <div class="prose text">
        <Content />
      </div>
    </div>

    {data.testimonial_quote && (
      <figure class="grid quote">
        <blockquote class="display">
          <p>“{data.testimonial_quote}”</p>
        </blockquote>
        <figcaption class="tick">
          <span class="who">{data.testimonial_name}</span>
          <span class="role">{data.testimonial_role}</span>
        </figcaption>
      </figure>
    )}
  </article>

  {more.length > 0 && (
    <section class="more-work" aria-labelledby="more-work-title">
      <header class="grid more-head">
        <h2 class="display" id="more-work-title">
          More work
        </h2>
        <a class="all" href="/">
          All work
          <svg viewBox="0 0 10 10" aria-hidden="true">
            <path d="M3 1.5 6.5 5 3 8.5" />
          </svg>
        </a>
      </header>
      <ProjectCards projects={more} pairs />
    </section>
  )}
</Base>

<style>
  .head {
    padding: 96px 0 0;
  }
  .head > * {
    grid-column: 1 / 4;
  }
  .label {
    margin: 0 0 12px;
  }
  .label a {
    color: var(--accent);
    font-weight: 600;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.06em;
    font-size: 1.1rem;
    text-decoration: none;
  }
  h1 {
    margin: 0;
    font-size: clamp(2.75rem, 7vw, 5rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .lede {
    max-width: 32em;
    margin: 28px 0 0;
    font-size: 1.35rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .facts {
    margin: 64px 0 0;
    row-gap: 24px;
  }
  .facts dt {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .facts dd {
    margin: 6px 0 0;
    font-size: 1.05rem;
    line-height: 1.5;
  }

  /* Guide to guide: photos touch the edges as they scroll past; the gallery
     pads its own first and last photo in by a gutter. */
  .gallery-wrap {
    margin-top: 64px;
  }

  .body {
    padding-top: 80px;
  }
  .aside {
    grid-column: 1;
    align-self: start;
    margin: 0;
    color: var(--muted);
  }
  .prose {
    grid-column: 2 / 5;
    font-size: 1.2rem;
    line-height: 1.65;
  }
  .prose :global(p),
  .prose :global(ul) {
    max-width: 36em;
  }
  .prose :global(p:first-child) {
    margin-top: 0;
  }
  .prose :global(h2) {
    margin: 2em 0 0.6em;
    font-family: var(--display);
    font-size: 1.3rem;
    font-weight: 700;
  }
  .prose :global(li) {
    margin: 0.5em 0;
  }
  .prose :global(li::marker) {
    color: var(--accent);
  }
  /* A bullet is a quiet grey dot; a numbered list keeps its numbers in ink. */
  .prose :global(ul > li::marker) {
    color: var(--faint);
  }
  .prose :global(strong) {
    font-family: var(--sans);
    font-weight: 700;
  }

  /* The client's quote, after the case study. */
  .quote {
    margin: 0;
    padding-top: 96px;
    row-gap: 24px;
  }
  .quote blockquote {
    grid-column: 2 / 5;
    margin: 0;
  }
  .quote blockquote p {
    margin: 0;
    max-width: 22em;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-indent: -0.4em;
    text-wrap: pretty;
  }
  .quote figcaption {
    grid-column: 2 / 5;
    display: grid;
    gap: 2px;
  }
  .quote .who {
    color: var(--ink);
    font-weight: 600;
  }
  .quote .role {
    color: var(--muted);
  }
  /* Two more projects, headed like the journal strip. */
  .more-work {
    padding-top: 120px;
  }
  .more-head {
    align-items: last baseline;
    padding-bottom: 32px;
  }
  .more-head h2 {
    grid-column: 1 / 3;
    margin: 0;
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .all {
    grid-column: 3 / 5;
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
  }
  .all svg {
    width: 0.7em;
    height: 0.7em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.15s ease-out;
  }
  /* Moves only on a real hover, and not under reduced motion. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .all:hover svg {
      transform: translateX(3px);
    }
  }
  @media (max-width: 860px) {
    .all {
      justify-self: start;
      margin-top: 12px;
    }
    .facts > div {
      grid-column: auto !important;
    }
    .facts {
      grid-template-columns: 1fr 1fr;
    }
    /* Above the case study, not beside it: room before the text starts. */
    .aside {
      margin-bottom: 20px;
    }
  }
</style>
